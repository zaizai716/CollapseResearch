{
  "data": {
    "train_data_path": "attribution_work/data/qwen/gen_2/training_data.jsonl",
    "test_data_path": "attribution_work/data/collapse_test.jsonl",
    "use_lm_format": true
  },
  "influence": {
    "outdir": "attribution_results/qwen/gen_2",
    "seed": 42,
    "cal_words_infl": true,
    "grads_path": "attribution_work/gradients/qwen/gen_2",
    "save_to_grads_path": true,
    "load_from_grads_path": false,
    "n_threads": 1,
    "top_k": 1000,
    "RapidGrad": {
      "enable": true,
      "RapidGrad_K": 65536,
      "shuffle_lambda": 20
    },
    "calculate_infl_in_gpu": true,
    "offload_train_grad": false,
    "offload_test_grad": false
  },
  "model": {
    "model_path": "attribution_work/checkpoints/qwen/gen_2/best.ckpt",
    "base_model_name": "Qwen/Qwen3-1.7B",
    "max_length": 512,
    "load_in_4bit": false
  }
}
